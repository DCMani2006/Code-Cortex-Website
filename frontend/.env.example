# URL of the registration/team/admin app (root src/App.tsx — a separate app,
# not part of this site). "TEAM LOGIN" and "ADMIN" in the header link here.
VITE_MAIN_APP_URL=http://localhost:5173

# Optional: injects an analytics script tag in the client if both are set.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Spotify app credentials (Client Credentials flow — catalog search only, no
# venue login/queue control). Create an app at developer.spotify.com/dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
