# Google Sheet acting as the database. Share the service account's email
# (from credentials.json) on this spreadsheet with Editor access, or every
# call 403s.
GOOGLE_SHEET_ID=

PORT=3000

# Locally, drop the service-account key at server/credentials.json (gitignored)
# and leave this blank. On a host built from git (no credentials.json on disk),
# paste the same file's contents here as a single-line JSON string instead.
# Create the key at https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_CREDENTIALS_JSON=

# Directory to store teamPasswords.json in. Leave unset locally (defaults to
# this folder). On a host with an ephemeral filesystem, point this at a
# mounted persistent volume so passwords survive redeploys.
TEAM_PASSWORDS_DIR=
