# REQUIRED: The ID of your Google Spreadsheet (acts as your database)
# Found in your Sheet URL: https://docs.google.com/spreadsheets/d/<THIS_LONG_ID>/edit
# The service account (see GOOGLE_CREDENTIALS_JSON below) must be shared on
# this exact spreadsheet as Editor, or every call 403s.
GOOGLE_SHEET_ID=1iJzLyrGA_SDPK85fpX3YM-SkOwDWykLAGjM70f_aXGU

# Server Port (keep as 3000)
PORT=3000

# OPTIONAL for Local Dev / REQUIRED for Cloud Deployments:
# In local dev: simply drop your service account key file at `server/credentials.json`.
# In cloud deploy (Railway/Render): paste the raw service account JSON string here:
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# REQUIRED: shared passcode for the admin/judging login (server/auth.js
# checkAdminPasscode). Unset means every passcode attempt is denied, not "open
# to everyone" — fails closed. NEVER reuse "tamreviewpanel_cc": that was the
# original value, it shipped in the client bundle, and it is permanently
# public via this (public) repo's git history.
ADMIN_PASSCODE=

# REQUIRED: signs the app's session tokens (server/auth.js signSession /
# verifySession). Any random 32+ char string — e.g. `openssl rand -hex 32`.
# Left unset, the server still works (fails open) but generates a random
# secret every boot, so every session is invalidated on each restart/redeploy.
SESSION_SECRET=

# RECOMMENDED: same value as the client's VITE_GOOGLE_CLIENT_ID. Lets the
# server confirm a Google sign-in token was actually issued for this app's
# OAuth client (not just any valid Google account) — see the "Layer 2" doc
# comment on verifyGoogleAccessToken in auth.js. Left unset, sign-in still
# works, just without that extra check.
GOOGLE_CLIENT_ID=

# OPTIONAL: rollout switch for the session-auth middleware. "log" (default)
# never rejects a request, it only decorates req.user and logs whether a
# valid token was present — safe to leave as-is indefinitely. "enforce"
# actually requires a valid session on protected routes; only flip this once
# logs show real traffic is already sending valid tokens.
AUTH_MODE=log
