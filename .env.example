# Google OAuth client ID for the participant "Sign in with Google" button
# (@react-oauth/google). This is separate from server/credentials.json, which
# is a service account for the backend's Google Sheets access — this one is a
# browser-side OAuth client, created at:
#   https://console.cloud.google.com/apis/credentials
#   Create Credentials -> OAuth client ID -> Application type: Web application
#   Authorized JavaScript origins: http://localhost:5173 (and your real domain)
# REQUIRED for Google Sign-In button
# Get from Google Cloud Console -> APIs & Credentials -> Create OAuth 2.0 Web Client ID
# Set Authorized JavaScript Origin: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=208264065196-ruemk4fk26lnm6ka3gcgp5qbo4241ljs.apps.googleusercontent.com

# Backend API URL (defaults to http://localhost:3000/api in development)
VITE_API_BASE_URL=http://localhost:3000/api

# Event Site URL (defaults to http://localhost:3001 in development)
VITE_EVENT_SITE_URL=http://localhost:3001